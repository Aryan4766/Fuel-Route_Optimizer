# Copy to .env and adjust. Values shown are the defaults.

# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Vehicle / optimisation assumptions ---
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
# Fraction of the tank that is full when the trip starts (1.0 = full tank).
# That starting fuel is treated as already paid for and is NOT charged.
INITIAL_FUEL_FRACTION=1.0
# Stations farther than this (straight-line miles) from the route are ignored.
STATION_CORRIDOR_MILES=10

# --- Data ---
# Geocoded station file produced by `python manage.py build_station_index`
STATIONS_DATA_PATH=data/stations_geocoded.csv

# --- External services (free, no API key) ---
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent. Put real contact info here.
HTTP_USER_AGENT=fuel-route-optimizer/1.0 (you@example.com)
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20

# --- Cache ---
# locmem (per process) | filebased (shared by gunicorn workers) | redis
CACHE_BACKEND=locmem
# Directory for filebased, or redis://host:port/db for redis (blank = default)
CACHE_LOCATION=
GEOCODE_CACHE_TTL_SECONDS=2592000
ROUTE_CACHE_TTL_SECONDS=86400

# --- Rate limiting (protects the upstream free services) ---
API_THROTTLE_RATE=60/min
